{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "winston-field-notes-publisher",
  "main": "src/index.js",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
