{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "winston-field-notes-publisher",
  "main": "src/index.js",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "LINKEDIN_REDIRECT_URI": "https://winston-field-notes-publisher.michelle-cb4.workers.dev/linkedin/callback"
  },
  "kv_namespaces": [
    {
      "binding": "LINKEDIN_STORE"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
